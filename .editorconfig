root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.{js,json}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.md]
trim_trailing_whitespace = false

# Helm templates
[**/helm/**/*.yaml]
indent_style = space
indent_size = 2

[**/templates/**/*.yaml]
indent_style = space
indent_size = 2

