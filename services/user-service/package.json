  "version": "1.0.0",
  "description": "User Service Microservice",
  "main": "server.js",
  "scripts": {
    "start": "node -r dotenv/config server.js dotenv_config_path=.env.production",
    "start:local": "node -r dotenv/config server.js dotenv_config_path=.env.local",
