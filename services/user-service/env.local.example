# User Service - Local Environment
NODE_ENV=development
PORT=3001
SERVICE_NAME=user-service
LOG_LEVEL=debug
API_PREFIX=/api

# CORS Settings
CORS_ORIGIN=http://localhost:3001,http://localhost:8080

# JWT Settings
JWT_SECRET=local_jwt_secret_key_change_in_production
JWT_EXPIRES_IN=24h

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Timeout Settings
REQUEST_TIMEOUT=30000

